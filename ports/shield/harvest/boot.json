  "findings": [
    {
      "id": "exact-stock-inputs",
      "status": "proven-source-evidence",
      "summary": "Official public NVIDIA 9.2.4 OTA metadata exactly matches the owner fingerprint, incremental build and security patch. Its embedded kernel configuration is byte-identical to the authorized stock ADB capture. Boot, DT variants and recovery reconstruction inputs are locally acquired without login.",
      "embedded_stock_config": {
        "bytes": 163243,
        "sha256": "325d2cf28000ddda0ad6c65f4083648b5bb4348d793e7a4406a423574ca7c4d4",
        "matches_authorized_adb_stock_config": true
      },
      "physical_device_boot_backup_obtained": false
    },
    {
      "id": "stock-header-and-compression",
      "status": "proven-source-evidence",
      "summary": "Exact-build normal boot and reconstructed recovery use Android header version 1, 2048-byte pages and a gzip-compressed ARM64 kernel. Normal boot has no ramdisk; recovery has a 9,529,963-byte gzip ramdisk. Both lack second-stage and recovery-DTBO payloads. Recovery and normal boot have identical kernel payloads.",
      "boot_header": {
        "version": 1,
        "page_bytes": 2048,
        "kernel_bytes": 11039537,
        "kernel_address_raw": "0x00991680",
        "tags_address_raw": "0x00989780",
        "ramdisk_bytes": 0,
        "second_stage_bytes": 0,
        "recovery_dtbo_bytes": 0,
        "header_bytes": 1648
      },
      "stock_kernel_arm64_header": {
        "code0": 340885504,
        "code1": 0,
        "text_offset": 524288,
        "image_size": 29872128,
        "flags": 10,
        "res2": 0,
        "res3": 0,
        "res4": 0,
        "magic": "ARMd",
        "res5": 0
      },
      "recovery_ramdisk_bytes": 9529963,
      "recovery_bytes": 20575528,
      "stock_normal_kernel_initramfs_source": "",
      "measured_load_addresses_confirmed": false,
      "raw_address_warning": "Raw AOSP-parsed kernel/tags/ramdisk fields derive from base10,000,000 decimal and lie below the Tegra DRAM window. They are format observations, not validated physical load addresses; do not blindly reuse them."
    },
    {
      "id": "current-recovery-reconstruction",
      "status": "verified-local-reconstruction",
      "summary": "The exact-build vendor install script source boot SHA-1 and size matched. Bounded BSDIFF40 application consumed all 44 controls and all streams, producing a 20,575,528-byte recovery whose SHA-1 matches the script. No stock installer was run.",
      "whole_ota_signature_verified": false,
      "physical_restore_tested": false
    },
    {
      "id": "darcy-dt-selection",
      "status": "proven-source-evidence",
      "summary": "The official release blob carries A00, 0050 A04, 0050 A08 and 0052 A08 vendor DTBs, repeated as RP1 entries. All four inherit nvidia,boardids=2530:0032:E0, so this property cannot select the owner SKU. Lineage recovery chooses the DT filename from /proc/device-tree/nvidia,dtsfilename and writes the selected DTB to the DTB partition. Its source explicitly says the recovery-DTBO slot is ignored on original Darcy; only B01 Mdarcy/Sif use it.",
      "owner_selected_variant_known": false
    },
    {
      "id": "lineage-kernel-integration",
      "status": "source-harvested",
      "summary": "The pinned lineage-23.2 Foster recipe uses Image.gz, header version 1 and optional nested Android/U-Boot wrapping. Tegra build supports 6.12/6.18 mixed GKI with explicit module and DT inventories; common prebuilt rules preserve matching modules. These are source references, not binary-compatible replacements for the pinned 7.1 Omarchy kernel.",
      "owner_bootloader_in_lineage_allowlist": false,
      "source_recovery_partition_bytes": 26767360,
      "owner_fastboot_recovery_partition_bytes": 26738688
    },
    {
      "id": "uboot-coverage",
      "status": "not-qualified",
      "summary": "Pinned Lineage U-Boot has upstream Darcy DT source but no Darcy/P2894 defconfig. Its baracus defconfig targets P2371-2180; the documented tegratab chainloader targets Tegra114. Neither establishes safe P2894 initialization or temporary boot support.",
      "p2894_uboot_verified": false
    },
    {
      "id": "kexec-alternative",
      "status": "concrete-unverified-candidate",
      "summary": "The owner stock kernel configuration enables CONFIG_KEXEC and CONFIG_KEXEC_CORE. The pinned kexec-tools ARM64 Image loader accepts an explicit DTB and initrd through the legacy kexec_load syscall. Its file-based syscall ignores an explicit DTB. This supplies a potential RAM-only mainline handoff after obtaining a controlled privileged stock-kernel environment, avoiding initial DTB partition writes.",
      "required_syscall_mode": "legacy kexec_load (-c/--kexec-syscall), not kexec_file_load",
      "needs_review": [
        "runtime RAM and reserved-memory/carveout propagation",
        "CPUhotplug/cache shutdown and Tegra firmware state",
        "root/SELinux syscall permission in controlled recovery",
        "matching explicit mainlineDTB and minimal diagnostic ramdisk",
        "working temporary stock-kernel boot entry; do not assume fastboot boot works"
      ],
      "physical_kexec_tested": false
    },
    {
      "id": "older-shield-lesson",
      "status": "historical-reference",
      "summary": "The 2018 shieldTV_loader reports fastboot boot trouble and solves it by replacing Android boot. It requires unlocking and 1080p HDMI and emits 4096-byte pages. Its source is archived for code study; it is not a qualified temporary boot method for current Darcy firmware."
    },
    {
      "id": "legacy-android-image-footer-integrity",
      "status": "verified-local-cryptographic-consistency",
      "summary": "Both acquired boot and reconstructed recovery carry legacy AndroidVerifiedBootSignature version 1 footers. An independent OpenSSL SHA-256/RSA verification passes over each padded image plus its authenticated target/size attributes. Both use the same embedded certificate. This strengthens recovery reconstruction integrity without establishing an independent hardware trust anchor or verifying the whole OTA package.",
      "embedded_certificate_sha256": "d871a3898f9ff87ffc79dd238dc3150574b1dd4e269fcde9335a6cfbae41e185",
      "embedded_certificate_signature_verified": true,
      "independent_trusted_certificate_pinned": false,
      "owner_hardware_trust_anchor_checked": false,
      "whole_ota_signature_verified": false
    }
  ],
  "gaps": [
    "The actual owner board SKU/revision and live nvidia,dtsfilename remain unavailable under stock ADB permissions. P2897 alone does not select A00/A04/A08.",
    "No raw physical boot/recovery/DTB backup exists; owner partition bytes have not been compared with the acquired official release image.",
    "Whole-OTA provider MD5 and package signatures remain unverified because only selected ZIP members were downloaded. Member CRC32, local SHA-256 and boot/recovery footer signatures with their embedded certificate are verified. The certificate has not been independently matched to the owner hardware trust anchor.",
    "The reconstructed recovery is a current-release input with the exact vendor target digest, not a tested restoration route. Recovery shell/root availability and temporary fastboot boot remain untested.",
    "Original Darcy mainline DT handoff needs either a reviewed chainload/kexec path or a separately reviewed DTB partition operation with exact recovery inputs. Attaching a DTB in the B01 recovery-DTBO slot does not solve this.",
    "No P2894 U-Boot configuration is verified. No custom boot image or loader was built during the harvest.",
    "Raw Android header addresses need NVIDIA CBoot interpretation; arithmetic base inference does not establish effective runtime load addresses.",
    "Privileged staging, USB diagnostics, CPU shutdown and runtime carveout propagation for kexec need combined source review and later qualification.",
    "The official developer 9.2.1 recovery archive still requires NVIDIA login; no login bypass was attempted. It is no longer the only recovery-input route because exact 9.2.4 reconstruction succeeded."
  ],
  "proposed_native_test_route": [
    {
      "step": 1,
      "kind": "offline-review",
      "action": "Reconcile the exact current stock boot, recovery and DT inputs with the board and firmware harvest. Preserve originals, digests and an explicit recovery plan. Independently review the BSDIFF receipt and AOSP header extraction; determine a package signature verification path."
    },
    {
      "step": 2,
      "kind": "owner-prerequisite",
      "action": "Before unlocking, finish a concrete boot/recovery candidate review, confirm owner data backup and physical fastboot-menu controls, then obtain explicit consent for unlocking and data erasure. This harvest does not authorize unlocking."
    },
    {
      "step": 3,
      "kind": "temporary-stock-kernel-entry-candidate",
      "action": "Investigate temporary boot of current-release recovery or a reviewed stock kernel plus controlled minimal ramdisk, preserving DTB and early boot partitions. fastboot boot and recovery privileged ADB support are unknown. Failure must not automatically trigger a persistent flash."
    },
    {
      "step": 4,
      "kind": "read-only-native-inventory",
      "action": "Once a controlled privileged stock-kernel environment exists, capture exact boot/recovery/DTB, live DTS filename and board metadata, /sys/firmware/fdt and RAM/carveout maps before a mainline handoff. Keep owner identifiers and keys private."
    },
    {
