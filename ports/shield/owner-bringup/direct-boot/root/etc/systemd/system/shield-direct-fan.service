[Unit]
Description=Shield fan at full speed when the DT has no thermal fan control (direct boot)
ConditionKernelCommandLine=shield.boot=direct
# A board DT that maps pwm-fan into cpu-thermal lets the kernel thermal governor drive the fan.
ConditionPathExists=!/proc/device-tree/thermal-zones/cpu-thermal/cooling-maps
After=systemd-udev-trigger.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sh -c 'for h in /sys/class/hwmon/hwmon*; do if [ "$(cat $h/name)" = pwmfan ]; then echo 2 > $h/pwm1_enable; echo 255 > $h/pwm1; fi; done'

[Install]
WantedBy=multi-user.target
