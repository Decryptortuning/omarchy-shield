[Unit]
Description=Enable Shield SDIO Wi-Fi by runtime overlay (older board DTs)
ConditionKernelCommandLine=shield.boot=direct
# A board DT that already enables the SDIO Wi-Fi needs neither the runtime overlay nor the private firmware path.
ConditionPathExists=!/proc/device-tree/mmc@700b0200/wifi@1/brcm,board-type
After=local-fs.target systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/modprobe brcmfmac alternative_fw_path=shield-wifi582
ExecStart=/usr/bin/sh -c '[ -e /sys/module/shield_wifi ] || /usr/bin/insmod /usr/lib/omarchy/shield/wifi/shield_wifi.ko overlay_path=shield-wifi582/wifi.dtbo'

[Install]
WantedBy=multi-user.target
