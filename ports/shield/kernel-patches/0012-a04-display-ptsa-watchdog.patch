+/* Fixed-clock LPDDR4 calibration recovered from the stock Shield 4.9.141
+ * driver.  The raw head demand is deliberately separate from ICC's fourfold
+ * ISO reservation.  Keep the vendor's intermediate truncation and DDA /4.
+ */
+static u32 tegra210_display_ptsa_rate(u32 peak_kbps)
+{
+	u64 fraction_fp, fraction_fpa;
+	u32 mbps;
+
+	if (!peak_kbps)
+		return 0;
+
+	mbps = peak_kbps / 1000 + 1;
+	fraction_fp = div_u64((u64)mbps * 176 * 1100, 4000000);
+	fraction_fpa = div_u64(fraction_fp * 10, 4);
+	return min_t(u64, DIV_ROUND_UP_ULL(fraction_fpa * 4096, 10000), 0xfff);
+}
+
+static bool tegra210_ptsa_hiso(struct tegra_mc *mc, unsigned int rate_reg)
+{
+	return (mc_readl(mc, rate_reg + 4) & 0x3f) == 0x3b &&
+		(mc_readl(mc, rate_reg + 8) & 0x3f) == 0x1f;
+}
+
+static int tegra210_mc_set_display_bandwidth(struct tegra_mc *mc,
+					    unsigned int head, u32 peak_kbps,
+					    bool prepare)
+{
+	u32 dis[2], ve, ve2, isp, ring, cpu_read, cpu_write;
+	unsigned long flags;
+
+	/* This first implementation qualifies only the measured LPDDR4 clock
+	 * profile.  Do not silently apply its calibration to another board or
+	 * after enabling EMC DVFS.
+	 */
+	if (!of_property_read_bool(mc->dev->of_node,
+				   "nvidia,display-ptsa-lpddr4") ||
+	    clk_get_rate(mc->clk) != 400000000 ||
+	    mc_readl(mc, 0x960) != 0x1203)
+		return -EOPNOTSUPP;
+	if (head > 1 || peak_kbps >= 4095000)
+		return -ERANGE;
+
+	spin_lock_irqsave(&mc->lock, flags);
+	/* A failed vblank confirmation retains the previous reservation.  The
+	 * next preparation must retain it too, until a confirmed frame finishes.
+	 */
+	if (prepare)
+		peak_kbps = max(peak_kbps, mc->display_peak_kbps[head]);
+	if (mc->display_ptsa_initialized &&
+	    mc->display_peak_kbps[head] == peak_kbps) {
+		spin_unlock_irqrestore(&mc->lock, flags);
+		return 0;
+	}
+
+	dis[0] = tegra210_display_ptsa_rate(head == 0 ? peak_kbps :
+					 mc->display_peak_kbps[0]);
+	dis[1] = tegra210_display_ptsa_rate(head == 1 ? peak_kbps :
+					 mc->display_peak_kbps[1]);
+	/* The stock display updater reserves the non-HISO VE baseline of 11
+	 * in RING1 even with cameras unused; it does not write camera registers.
+	 * Preserve current camera HISO allocations and current CPU rates.
+	 */
+	ve = tegra210_ptsa_hiso(mc, 0x434) ? mc_readl(mc, 0x434) & 0xfff : 11;
+	ve2 = tegra210_ptsa_hiso(mc, 0x494) ? mc_readl(mc, 0x494) & 0xfff : 0;
+	isp = tegra210_ptsa_hiso(mc, 0x4a0) ? mc_readl(mc, 0x4a0) & 0xfff : 0;
+	cpu_read = mc_readl(mc, 0x44c) & 0xfff;
+	cpu_write = mc_readl(mc, 0x50c) & 0xfff;
+	ring = max_t(u32, (dis[0] + dis[1] + ve + ve2 + isp) / 2 +
+			 cpu_read + cpu_write, 1);
+	if (ring > 0xfff) {
+		spin_unlock_irqrestore(&mc->lock, flags);
+		return -ERANGE;
+	}
+
+	/* Stock sequence: shared feeder first, followed by both display heads. */
+	mc_writel(mc, 0x3b, 0x480);
+	mc_writel(mc, 0x1f, 0x484);
+	mc_writel(mc, ring, 0x47c);
+	mc_writel(mc, 0x3b, 0x420);
+	mc_writel(mc, 0x1f, 0x424);
+	mc_writel(mc, dis[0], 0x41c);
+	mc_writel(mc, 0x3b, 0x42c);
+	mc_writel(mc, 0x1f, 0x430);
+	mc_writel(mc, dis[1], 0x428);
+	mc->display_peak_kbps[head] = peak_kbps;
+	mc->display_ptsa_initialized = true;
+	spin_unlock_irqrestore(&mc->lock, flags);
+
+	dev_info(mc->dev, "display PTSA head=%u peak=%ukB/s DIS=%u/%u RING1=%u\n",
+		 head, peak_kbps, dis[0], dis[1], ring);
+	return 0;
+}
