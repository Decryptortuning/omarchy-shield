+/* Preserve the qualified T210 boot-kernel watchdog across kexec.  Its timer7
+ * expires every 60 seconds and WDT0 resets on the fourth expiration.  Until
+ * retiming is qualified, accept only this exact active configuration.
+ */
+#define T210_WDT_CFG			0x8017
+#define T210_WDT_TIMER_BASE		0x70
+#define T210_WDT_TIMER_PTV		(TIMER_EN | TIMER_PERIODIC | 60000000U)
+#define T210_WDT_TIMEOUT			240
+#define WDT_STS_ACTIVE			BIT(0)
+
+static bool tegra210_wdt_can_adopt(u32 cfg, u32 status, u32 ptv)
+{
+	return cfg == T210_WDT_CFG && (status & WDT_STS_ACTIVE) &&
+		ptv == T210_WDT_TIMER_PTV;
+}
+
+static int tegra210_wdt_ping(struct watchdog_device *wdd)
+{
+	struct tegra_wdt *wdt = watchdog_get_drvdata(wdd);
+	u32 cfg, status, ptv, pcr;
+
+	cfg = readl(wdt->wdt_regs + WDT_CFG);
+	status = readl(wdt->wdt_regs + WDT_STS);
+	ptv = readl(wdt->tmr_regs + TIMER_PTV);
+	if (!tegra210_wdt_can_adopt(cfg, status, ptv)) {
+		dev_err_ratelimited(wdd->parent,
+			"inherited watchdog changed: cfg=%08x sts=%08x ptv=%08x\n",
+			cfg, status, ptv);
+		return -EIO;
+	}
+
+	/* Never unlock, disable, retime or select another timer. */
+	pcr = readl(wdt->tmr_regs + 4);
+	writel(WDT_CMD_START_COUNTER, wdt->wdt_regs + WDT_CMD);
+	if (wdt->adoption_pings++ < 4)
+		dev_info(wdd->parent,
+			"adoption ping: cfg=%08x ptv=%08x sts=%08x/%08x pcr=%08x/%08x\n",
+			cfg, ptv, status, readl(wdt->wdt_regs + WDT_STS),
+			pcr, readl(wdt->tmr_regs + 4));
+	return 0;
+}
+
+static const struct watchdog_info tegra210_wdt_info = {
+	.options = WDIOF_KEEPALIVEPING,
+	.identity = "Tegra210 inherited watchdog",
+};
+
+static const struct watchdog_ops tegra210_wdt_ops = {
+	.owner = THIS_MODULE,
+	.start = tegra210_wdt_ping,
+	.ping = tegra210_wdt_ping,
 };
 
