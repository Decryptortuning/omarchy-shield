+void tegra_crtc_update_display_bandwidth(struct drm_crtc *crtc,
+					struct drm_atomic_state *state, bool prepare)
+{
+	const struct tegra_dc_state *old, *new;
+	struct tegra_dc *dc = to_tegra_dc(crtc);
+	u32 peak;
+	int err;
+
+	if (!dc->mc)
+		return;
+
+	old = to_dc_state(drm_atomic_get_old_crtc_state(state, crtc));
+	new = to_dc_state(drm_atomic_get_new_crtc_state(state, crtc));
+	if (!prepare) {
+		if (new->base.active &&
+		    (!new->display_vblank_valid ||
+		     new->display_vblank_count == drm_crtc_vblank_count(crtc)))
+			return;
+		if (!new->base.active && !new->display_stop_confirmed)
+			return;
+	}
+	peak = prepare ? max(old->peak_display_bandwidth,
+			     new->peak_display_bandwidth) :
+			 new->peak_display_bandwidth;
+
+	err = tegra_mc_set_display_bandwidth(dc->mc, dc->pipe, peak, prepare);
+	if (err)
+		dev_err_ratelimited(dc->dev, "display bandwidth update failed: %d\n", err);
+}
