From: Omarchy Shield contributors
Subject: [PATCH] arm64: dts: tegra: describe original Darcy A04 sensor wiring

Add a separate A04 leaf using the common P2894 electrical definitions.
Exact-release A04/A08 and live A04 comparisons agree for selected rails,
DFLL and fan wiring. A04 enables the TMP451 on I2C1, unlike A08.
Map its supply, alert and channels to the current LM90 binding.
Keep existing SoC cooling policy; vendor DRAM/DVFS actions remain unported.

Based on ACK Tegra 9336ceeebe1d75021d9fd98c94abaec522ba39b3 with
0001-fan53555-regmap and 0002-darcy-inverted-fan applied.

--- /dev/null
+++ b/arch/arm64/boot/dts/nvidia/tegra210-p2894-0050-a04.dts
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include <dt-bindings/pwm/pwm.h>
+
+#include "tegra210.dtsi"
+#include "tegra210-p2894.dtsi"
+
+/ {
+	model = "NVIDIA Shield TV (Darcy A04)";
+	compatible = "nvidia,p2894-0050-a04", "nvidia,darcy", "nvidia,tegra210";
+
+	mmc@700b0200 {
+		status = "okay";
+		bus-width = <4>;
+		non-removable;
+		power-gpios = <&gpio TEGRA_GPIO(H, 0) GPIO_ACTIVE_HIGH>;
+		vqmmc-supply = <&max77620_sd3>;
+		vmmc-supply = <&vdd_3v3>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		wifi@1 {
+			compatible = "brcm,bcm4354-fmac", "brcm,bcm4329-fmac";
+			reg = <1>;
+			interrupt-parent = <&gpio>;
+			interrupts = <TEGRA_GPIO(H, 2) IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "host-wake";
+		};
+	};
+};
+
+/* Keep the GPU rail normal while adding an explicit fan polarity cell. */
+&pwm {
+	#pwm-cells = <3>;
+};
+
+&vdd_gpu {
+	pwms = <&pwm 1 8000 0>;
+};
+
+&fan {
+	pwms = <&pwm 3 65536 PWM_POLARITY_INVERTED>;
+	cooling-levels = <0 127 191 255>;
+};
+
+/* A04 populates the TMP451; A08 leaves this device disabled. */
+&{/i2c@7000c000} {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	tmp451: temperature-sensor@4c {
+		compatible = "ti,tmp451";
+		reg = <0x4c>;
+		vcc-supply = <&max77620_sd3>;
+		interrupt-parent = <&gpio>;
+		interrupts = <TEGRA_GPIO(X, 4) IRQ_TYPE_LEVEL_LOW>;
+		#thermal-sensor-cells = <1>;
+		ti,extended-range-enable;
+	};
+};
+
+/ {
+	thermal-zones {
+		/* Monitor both channels; vendor DVFS/DRAM maps need separate ports. */
+		board-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <1000>;
+			thermal-sensors = <&tmp451 0>;
+		};
+
+		diode-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <1000>;
+			thermal-sensors = <&tmp451 1>;
+		};
+	};
+};
--- a/arch/arm64/boot/dts/nvidia/Makefile
+++ b/arch/arm64/boot/dts/nvidia/Makefile
@@ -29,6 +29,7 @@
 dtb-$(CONFIG_ARCH_TEGRA_210_SOC) += tegra210-p3450-0000.dtb
 dtb-$(CONFIG_ARCH_TEGRA_210_SOC) += tegra210-p3541-0000.dtb
 dtb-$(CONFIG_ARCH_TEGRA_210_SOC) += tegra210-smaug.dtb
+dtb-$(CONFIG_ARCH_TEGRA_210_SOC) += tegra210-p2894-0050-a04.dtb
 dtb-$(CONFIG_ARCH_TEGRA_210_SOC) += tegra210-p2894-0050-a08.dtb
 dtb-$(CONFIG_ARCH_TEGRA_210_SOC) += tegra210b01-p2894-2551-b00.dtb
 dtb-$(CONFIG_ARCH_TEGRA_210_SOC) += tegra210b01-p3425-0050-a04.dtb
--- a/Documentation/devicetree/bindings/arm/tegra.yaml
+++ b/Documentation/devicetree/bindings/arm/tegra.yaml
@@ -225,7 +225,9 @@
           - const: nvidia,tegra210
       - description: NVIDIA Shield TV
         items:
-          - const: nvidia,p2894-0050-a08
+          - enum:
+              - nvidia,p2894-0050-a04
+              - nvidia,p2894-0050-a08
           - const: nvidia,darcy
           - const: nvidia,tegra210
       - description: Google Pixel C
