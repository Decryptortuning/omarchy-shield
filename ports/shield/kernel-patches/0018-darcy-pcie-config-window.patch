+/* Explicit board/DT opt-in; validate before clocks, resets or PHY effects. */
+static int tegra_pcie_darcy_config_window_init(struct platform_device *pdev,
+					     struct tegra_pcie *pcie)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	int length;
+
+	if (!of_find_property(dev->of_node, "nvidia,darcy-axi-config-window",
+			      &length))
+		return 0;
+
+	if (length ||
+	    !of_machine_is_compatible("nvidia,p2894-0050-a04") ||
+	    !of_device_is_compatible(dev->of_node, "nvidia,tegra210-pcie"))
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid Darcy config-window opt-in\n");
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "cs");
+	if (!res || res->start != DARCY_CFG_CPU_LAST_PAGE ||
+	    res->end != DARCY_CFG_CPU_END - 1 ||
+	    resource_size(res) != SZ_4K)
+		return dev_err_probe(dev, -EINVAL,
+				     "Darcy config aperture must be 0x11fff000/4K\n");
+
+	pcie->darcy_axi_config_window = true;
+	return 0;
 }
 
