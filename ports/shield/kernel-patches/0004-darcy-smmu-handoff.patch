From: Omarchy Shield contributors
Subject: [PATCH] iommu: tegra-smmu: add opt-in Darcy A04 recovery handoff reset

An old recovery kernel can leave enabled SWGROUP translations and page tables.
The selected kernel starts default identity domains, whose first attach does
not reset inherited registers; USB/MMC/PCIe DT nodes lack iommus entirely.

Add a default-off tegra_smmu.reset_inherited=1 bring-up parameter scoped to
original Darcy A04/T210. Clear/read back only ASID_ENABLE through the existing
SoC table before cache flush/global enable/registration. Keep client bits,
PTB slots and the existing default-domain policy. Panic on an unsupported or
failed requested reset, and require successful probe at subsys_initcall:
run after OF population creates MC and before normal DMA device probes.
The parent MC driver can otherwise swallow SMMU probe errors.

All 39 T210 SWGROUP registers are backed by upstream commit
4a91b11c0a100532c466e07a1372d134ab0e753d, which cites the Tegra X1 TRM and
has NVIDIA maintainer acknowledgement. The matching vendor driver disables
translation by clearing the group ASID register without clearing client bits.

This requires a separately reviewed old-kernel master shutdown sequence.
It does not quiesce DMA and is not authorization or qualification for kexec.

--- a/drivers/iommu/tegra-smmu.c
+++ b/drivers/iommu/tegra-smmu.c
@@ -6,7 +6,9 @@
 #include <linux/bitops.h>
 #include <linux/debugfs.h>
 #include <linux/err.h>
+#include <linux/init.h>
 #include <linux/iommu.h>
+#include <linux/moduleparam.h>
 #include <linux/kernel.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
@@ -20,6 +22,23 @@
 #include <soc/tegra/mc.h>
 
 #include "iommu-pages.h"
+
+/* Experimental recovery handoff; masters must already be quiesced. */
+static bool reset_inherited;
+static bool handoff_reset_complete;
+module_param_named(reset_inherited, reset_inherited, bool, 0400);
+MODULE_PARM_DESC(reset_inherited,
+		"Require an A04/T210 inherited SMMU reset before device probing");
+
+/* MC probe errors are swallowed by the parent, so verify before device_init. */
+static int __init tegra_smmu_check_handoff_reset(void)
+{
+	if (reset_inherited && !handoff_reset_complete)
+		panic("tegra-smmu: requested handoff reset did not complete");
+
+	return 0;
+}
+subsys_initcall(tegra_smmu_check_handoff_reset);
 
 struct tegra_smmu_group {
 	struct list_head list;
@@ -1102,6 +1121,43 @@
 	debugfs_remove_recursive(smmu->debugfs);
 }
 
+/*
+ * Recovery may leave translated SWGROUPs even for target devices without an
+ * iommus property. First identity-domain attach does not clear old hardware.
+ * Use the documented SoC register table, keeping client enable/reserved bits
+ * and PTB slots intact. An unreferenced PTB is replaced before paging attach.
+ * This only establishes target translation state; it cannot stop old DMA.
+ */
+static void tegra_smmu_reset_handoff(struct tegra_smmu *smmu)
+{
+	unsigned int i, cleared = 0;
+	u32 value;
+
+	if (!reset_inherited)
+		return;
+
+	if (!of_machine_is_compatible("nvidia,p2894-0050-a04") ||
+	    !of_device_is_compatible(smmu->dev->of_node, "nvidia,tegra210-mc") ||
+	    !smmu->soc->num_swgroups || handoff_reset_complete)
+		panic("tegra-smmu: unsupported or repeated A04 handoff reset");
+
+	for (i = 0; i < smmu->soc->num_swgroups; i++) {
+		const struct tegra_smmu_swgroup *group = &smmu->soc->swgroups[i];
+
+		value = smmu_readl(smmu, group->reg);
+		if (!(value & SMMU_ASID_ENABLE))
+			continue;
+
+		smmu_writel(smmu, value & ~SMMU_ASID_ENABLE, group->reg);
+		if (smmu_readl(smmu, group->reg) & SMMU_ASID_ENABLE)
+			panic("tegra-smmu: cannot disable inherited SWGROUP %#x", group->reg);
+		cleared++;
+	}
+
+	smmu_flush(smmu);
+	dev_info(smmu->dev, "disabled %u inherited SMMU SWGROUPs\n", cleared);
+}
+
 struct tegra_smmu *tegra_smmu_probe(struct device *dev,
 				    const struct tegra_smmu_soc *soc,
 				    struct tegra_mc *mc)
@@ -1144,6 +1200,8 @@
 	dev_dbg(dev, "TLB lines: %u, mask: %#lx\n", smmu->soc->num_tlb_lines,
 		smmu->tlb_mask);
 
+	tegra_smmu_reset_handoff(smmu);
+
 	value = SMMU_PTC_CONFIG_ENABLE | SMMU_PTC_CONFIG_INDEX_MAP(0x3f);
 
 	if (soc->supports_request_limit)
@@ -1179,6 +1237,9 @@
 	if (IS_ENABLED(CONFIG_DEBUG_FS))
 		tegra_smmu_debugfs_init(smmu);
 
+	if (reset_inherited)
+		handoff_reset_complete = true;
+
 	return smmu;
 }
 
