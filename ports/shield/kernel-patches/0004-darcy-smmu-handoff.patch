From: Omarchy Shield contributors
Subject: [PATCH] iommu: tegra-smmu: add opt-in Darcy A04 recovery handoff policy

Recovery can leave enabled SWGROUP translations and page tables. Identity
attach does not reset inherited registers, and USB/MMC DT nodes lack iommus.
Add a default-off A04/T210 reset and a post-OF, pre-device completion gate.
Clear/read back only group ASID_ENABLE; fail closed on any requested failure.

A native probe stopped at GPUB (0xaac), whose enable bit resisted clearing.
Do not infer that it is read-only or secure. An additional default-off option
may retain this register only with the exact stamped diagnostic DT and an
explicitly disabled GM20B node. Deny all 128 paging ASIDs before IOMMU
registration, leaving every PTB slot untouched; GPUB packs four selectors.
All other 38 groups retain strict reset/readback. This is CPU/USB/thermal
bring-up only, not a GPU mapping or desktop handoff. Old page-table RAM is
not preserved, so independently quiescing the old GPU remains mandatory.

The 39-register table comes from upstream 4a91b11c0a100532c466e07a1372d134ab0e753d.
GPUB's four ASID selectors are also described by NVIDIA's legacy driver and
https://lkml.indiana.edu/hypermail/linux/kernel/2109.1/09989.html.
This policy does not stop old DMA or qualify native device operation.

--- a/drivers/iommu/tegra-smmu.c
+++ b/drivers/iommu/tegra-smmu.c
@@ -3,10 +3,13 @@
  * Copyright (C) 2011-2014 NVIDIA CORPORATION.  All rights reserved.
  */
 
+#include <linux/bitmap.h>
 #include <linux/bitops.h>
 #include <linux/debugfs.h>
 #include <linux/err.h>
+#include <linux/init.h>
 #include <linux/iommu.h>
+#include <linux/moduleparam.h>
 #include <linux/kernel.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
@@ -20,6 +23,31 @@
 #include <soc/tegra/mc.h>
 
 #include "iommu-pages.h"
+
+/* Experimental recovery handoff; masters must already be quiesced. */
+static bool reset_inherited;
+static bool preserve_disabled_gpu;
+static bool handoff_reset_complete;
+module_param_named(reset_inherited, reset_inherited, bool, 0400);
+MODULE_PARM_DESC(reset_inherited,
+		"Require an A04/T210 inherited SMMU reset before device probing");
+
+module_param_named(preserve_disabled_gpu, preserve_disabled_gpu, bool, 0400);
+MODULE_PARM_DESC(preserve_disabled_gpu,
+		"Retain GPUB state only for the stamped GPU-disabled RAM probe; forbid paging ASIDs");
+
+/* MC probe errors are swallowed by the parent, so verify before device_init. */
+static int __init tegra_smmu_check_handoff_reset(void)
+{
+	if (preserve_disabled_gpu && !reset_inherited)
+		panic("tegra-smmu: GPU retention requires inherited reset");
+
+	if ((reset_inherited || preserve_disabled_gpu) && !handoff_reset_complete)
+		panic("tegra-smmu: requested handoff reset did not complete");
+
+	return 0;
+}
+subsys_initcall(tegra_smmu_check_handoff_reset);
 
 struct tegra_smmu_group {
 	struct list_head list;
@@ -1102,6 +1130,80 @@
 	debugfs_remove_recursive(smmu->debugfs);
 }
 
+/*
+ * Recovery may leave translated SWGROUPs even for target devices without an
+ * iommus property. First identity-domain attach does not clear old hardware.
+ * Use the documented SoC register table, keeping client enable/reserved bits
+ * and PTB slots intact. An unreferenced PTB is replaced before paging attach.
+ * This only establishes target translation state; it cannot stop old DMA.
+ */
+static void tegra_smmu_reset_handoff(struct tegra_smmu *smmu)
+{
+	unsigned int i, cleared = 0, gpu_groups = 0;
+	struct device_node *gpu, *chosen;
+	const char *status, *stamp;
+	bool valid;
+	u32 value, observed;
+
+	if (!reset_inherited) {
+		if (preserve_disabled_gpu)
+			panic("tegra-smmu: GPU retention requires inherited reset");
+		return;
+	}
+
+	if (!of_machine_is_compatible("nvidia,p2894-0050-a04") ||
+	    !of_device_is_compatible(smmu->dev->of_node, "nvidia,tegra210-mc") ||
+	    !smmu->soc->num_swgroups || handoff_reset_complete)
+		panic("tegra-smmu: unsupported or repeated A04 handoff reset");
+
+	if (preserve_disabled_gpu) {
+		gpu = of_find_node_by_path("/gpu@57000000");
+		chosen = of_find_node_by_path("/chosen");
+		valid = gpu && chosen &&
+			of_device_is_compatible(gpu, "nvidia,gm20b") &&
+			!of_property_read_string(gpu, "status", &status) &&
+			!strcmp(status, "disabled") &&
+			!of_property_read_string(chosen, "shield,first-ram-probe", &stamp) &&
+			!strcmp(stamp, "a04-first-ram-probe-v1") &&
+			smmu->soc->num_asids == 128 && smmu->soc->num_swgroups == 39;
+		of_node_put(gpu);
+		of_node_put(chosen);
+		for (i = 0; i < smmu->soc->num_swgroups; i++)
+			if (smmu->soc->swgroups[i].reg == 0xaac)
+				gpu_groups++;
+		if (!valid || gpu_groups != 1)
+			panic("tegra-smmu: GPU retention requires exact disabled-GPU RAM probe");
+
+		/* GPUB has four ASID selectors. For this diagnostic, deny every
+		 * paging ASID before IOMMU registration, retaining all PTB slots.
+		 * Old table RAM is not preserved; the GPU must remain quiescent.
+		 */
+		bitmap_fill(smmu->asids, smmu->soc->num_asids);
+	}
+
+	for (i = 0; i < smmu->soc->num_swgroups; i++) {
+		const struct tegra_smmu_swgroup *group = &smmu->soc->swgroups[i];
+
+		value = smmu_readl(smmu, group->reg);
+		if (preserve_disabled_gpu && group->reg == 0xaac) {
+			dev_info(smmu->dev, "retained inactive GPUB %#x; all paging ASIDs unavailable\n", value);
+			continue;
+		}
+		if (!(value & SMMU_ASID_ENABLE))
+			continue;
+
+		smmu_writel(smmu, value & ~SMMU_ASID_ENABLE, group->reg);
+		observed = smmu_readl(smmu, group->reg);
+		if (observed & SMMU_ASID_ENABLE)
+			panic("tegra-smmu: cannot disable inherited SWGROUP %#x (%#x -> %#x)",
+			      group->reg, value, observed);
+		cleared++;
+	}
+
+	smmu_flush(smmu);
+	dev_info(smmu->dev, "disabled %u inherited SMMU SWGROUPs\n", cleared);
+}
+
 struct tegra_smmu *tegra_smmu_probe(struct device *dev,
 				    const struct tegra_smmu_soc *soc,
 				    struct tegra_mc *mc)
@@ -1144,6 +1246,8 @@
 	dev_dbg(dev, "TLB lines: %u, mask: %#lx\n", smmu->soc->num_tlb_lines,
 		smmu->tlb_mask);
 
+	tegra_smmu_reset_handoff(smmu);
+
 	value = SMMU_PTC_CONFIG_ENABLE | SMMU_PTC_CONFIG_INDEX_MAP(0x3f);
 
 	if (soc->supports_request_limit)
@@ -1179,6 +1283,9 @@
 	if (IS_ENABLED(CONFIG_DEBUG_FS))
 		tegra_smmu_debugfs_init(smmu);
 
+	if (reset_inherited)
+		handoff_reset_complete = true;
+
 	return smmu;
 }
 
