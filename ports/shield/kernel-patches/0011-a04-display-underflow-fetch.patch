+/* Tegra210's downstream driver resets the affected window's underflow
+ * counter before clearing its interrupt status. Keep other generations and
+ * all enables and vblank handling unchanged. This helper does not modify
+ * masks; the deferred IRQ path manages temporary source masking.
+ */
+static void tegra_dc_ack_irq(struct tegra_dc *dc, u32 status)
+{
+	if (dc->soc->clear_underflow_counters) {
+		if (status & WIN_A_UF_INT)
+			tegra_dc_writel(dc, 0, DC_WINBUF_AD_UFLOW_STATUS);
+		if (status & WIN_B_UF_INT)
+			tegra_dc_writel(dc, 0, DC_WINBUF_BD_UFLOW_STATUS);
+		if (status & WIN_C_UF_INT)
+			tegra_dc_writel(dc, 0, DC_WINBUF_CD_UFLOW_STATUS);
+	}
+
+	tegra_dc_writel(dc, status, DC_CMD_INT_STATUS);
+}
+
+/* Caller holds irq_lock. Preserve completion IRQs while the level-triggered
+ * window fault is processed after a bounded delay, as in NVIDIA's T21x driver.
+ */
+static u32 tegra_dc_defer_underflow(struct tegra_dc *dc, u32 status)
+{
+	u32 underflow, mask;
+
+	if (!dc->soc->clear_underflow_counters || !dc->underflow_active)
+		return status;
+
+	mask = tegra_dc_readl(dc, DC_CMD_INT_MASK);
+	underflow = status & mask & TEGRA_DC_WINDOW_UF;
+	if (underflow) {
+		tegra_dc_writel(dc, mask & ~underflow, DC_CMD_INT_MASK);
+		dc->underflow_pending |= underflow;
+		dc->stats.uf_episodes++;
+		schedule_delayed_work(&dc->underflow_work, msecs_to_jiffies(1));
+	}
+
+	/* The worker acknowledges the saved underflow after clearing counters. */
+	return status & ~TEGRA_DC_WINDOW_UF;
+}
+
+static void tegra_dc_underflow_work(struct work_struct *work)
+{
+	struct tegra_dc *dc = container_of(to_delayed_work(work),
+					 struct tegra_dc, underflow_work);
+	unsigned long flags;
+	u32 pending, mask;
+
+	spin_lock_irqsave(&dc->irq_lock, flags);
+	if (!dc->underflow_active)
+		goto unlock;
+
+	pending = dc->underflow_pending;
+	dc->underflow_pending = 0;
+	if (pending) {
+		tegra_dc_ack_irq(dc, pending);
+		mask = tegra_dc_readl(dc, DC_CMD_INT_MASK);
+		tegra_dc_writel(dc, mask | pending, DC_CMD_INT_MASK);
+		dc->stats.uf_deferred++;
+	}
+unlock:
+	spin_unlock_irqrestore(&dc->irq_lock, flags);
+}
+
+static void tegra_dc_underflow_stop(struct tegra_dc *dc)
+{
+	unsigned long flags;
+	u32 mask;
+
+	if (!dc->soc->clear_underflow_counters)
+		return;
+
+	spin_lock_irqsave(&dc->irq_lock, flags);
+	/* Inactive callers may already have their clocks and power disabled. */
+	if (dc->underflow_active) {
+		dc->underflow_active = false;
+		mask = tegra_dc_readl(dc, DC_CMD_INT_MASK);
+		tegra_dc_writel(dc, mask & ~TEGRA_DC_WINDOW_UF, DC_CMD_INT_MASK);
+	}
+	dc->underflow_pending = 0;
+	spin_unlock_irqrestore(&dc->irq_lock, flags);
+	/* No IRQ can queue another worker after active was cleared under lock. */
+	cancel_delayed_work_sync(&dc->underflow_work);
+}
