 	.atomic_destroy_state = tegra_plane_atomic_destroy_state,
 	.format_mod_supported = tegra_plane_format_mod_supported,
 };
+
+static void tegra_dc_probe_mapping(struct tegra_dc *dc,
+				   struct tegra_plane_state *state,
+				   struct tegra_bo *bo,
+				   struct host1x_bo_mapping *map)
+{
+	static atomic_t samples = ATOMIC_INIT(0);
+	struct drm_framebuffer *fb = state->base.fb;
+	struct iommu_domain *domain;
+	phys_addr_t first_pa = 0, last_pa = 0;
+	u64 first, last, address;
+	unsigned int pages = 0, holes = 0;
+
+	/* Read-only, bounded diagnostic for the exact current scanout. The BO
+	 * remains pinned while its software page tables are inspected here.
+	 */
+	if (!dc->mc || !dc->soc->clear_underflow_counters ||
+	    to_tegra_plane(state->base.plane)->index != 0 ||
+	    fb->width != 1280 || fb->height != 720 || fb->pitches[0] != 5120 ||
+	    fb->format->num_planes != 1 || fb->format->cpp[0] != 4 ||
+	    atomic_inc_return(&samples) > 32)
+		return;
+
+	if ((u64)state->iova[0] > 0xffffffffULL)
+		return;
+	first = (u64)state->iova[0] + fb->offsets[0];
+	if (first > 0xffffffffULL - 3686400 + 1)
+		return;
+	last = first + 3686400 - 1;
+	domain = iommu_get_domain_for_dev(dc->dev);
+	if (domain && dc->client.group) {
+		first_pa = iommu_iova_to_phys(domain, first);
+		last_pa = iommu_iova_to_phys(domain, last);
+		for (address = first & PAGE_MASK; address <= last; address += PAGE_SIZE) {
+			pages++;
+			if (!iommu_iova_to_phys(domain, address))
+				holes++;
+		}
+	}
+	dev_info(dc->dev,
+		 "SHIELD_DC_MAPPING domain=%p type=%#x explicit=%u iova=%#llx-%#llx bo_iova=%pad bo_size=%zu mapped=%zu dma=%pad chunks=%u pages=%u holes=%u phys=%pa-%pa modifier=%#llx\n",
+		 domain, domain ? domain->type : 0, !!dc->client.group,
+		 first, last, &bo->iova, bo->gem.size, bo->size,
+		 &map->phys, map->chunks, pages, holes, &first_pa, &last_pa,
+		 fb->modifier);
+}
 
 static int tegra_dc_pin(struct tegra_dc *dc, struct tegra_plane_state *state)
 {
