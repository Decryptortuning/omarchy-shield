+/* The MC client remains blocked while the display partition is powered off.
+ * Keep this reset separate from CAR: power-up must release CAR before MC.
+ */
+static int tegra_dc_assert_resets(struct tegra_dc *dc)
+{
+	int err, rollback;
+
+	err = reset_control_assert(dc->rst_mc);
+	if (err < 0)
+		goto unblock_mc;
+
+	err = reset_control_assert(dc->rst);
+	if (!err)
+		return 0;
+
+unblock_mc:
+	/* A failed MC drain can already have blocked new requests. */
+	rollback = reset_control_deassert(dc->rst_mc);
+	if (rollback < 0) {
+		dc->reset_fault = true;
+		dev_err(dc->dev, "failed to unblock MC after reset error: %d\n",
+			rollback);
+	}
+	return err;
+}
