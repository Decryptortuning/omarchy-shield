--- a/arch/arm64/boot/dts/nvidia/tegra210-p2894-0050-a04.dts
+++ b/arch/arm64/boot/dts/nvidia/tegra210-p2894-0050-a04.dts
@@ -82,3 +82,16 @@
 	resets = <&mc TEGRA210_MC_RESET_XUSB_HOST>,
 		 <&tegra_car TEGRA210_CLK_XUSB_HOST>;
 };
+
+/* Each head owns its MC drain separately from the CAR module reset. */
+&{/host1x@50000000/dc@54200000} {
+	resets = <&tegra_car TEGRA210_CLK_DISP1>, <&mc TEGRA210_MC_RESET_DC>;
+	reset-names = "dc", "mc";
+	nvidia,memory-controller = <&mc>;
+};
+
+&{/host1x@50000000/dc@54240000} {
+	resets = <&tegra_car TEGRA210_CLK_DISP2>, <&mc TEGRA210_MC_RESET_DCB>;
+	reset-names = "dc", "mc";
+	nvidia,memory-controller = <&mc>;
+};
