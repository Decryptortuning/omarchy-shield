pkgname=omarchy-shield
pkgver=0.1.0
pkgrel=4
pkgdesc='NVIDIA Shield TV experimental Omarchy platform integration'
arch=('aarch64')
license=('MIT')
depends=('bash' 'kmod' 'python' 'omarchy' 'linux-shield')
source=('lifecycle' 'collect-shield-linux.py' 'hardware.json' 'hardware-darcy.json')
sha256sums=('b4107398484437f344d8959d7920a5164769b083b7f67ba3439a815208c19fee'
  'ed90d9be0338c0b2078e959c3fcee9c53c799f647e996551e9ab6cc896d7e1d6'
  'd91cbc584a8a4c2de03c57f918e91969758a847034cd15055a2579ea758d893a'
  '2fcb496a4212b3eb71fb4073b712631fecc5584fa404b8ce33ab4d0523e71ada')

package() {
  install -Dm755 lifecycle "$pkgdir/usr/lib/omarchy/shield/lifecycle"
  install -Dm755 collect-shield-linux.py "$pkgdir/usr/lib/omarchy/shield/collect-shield-linux.py"
  install -Dm644 hardware.json "$pkgdir/usr/lib/omarchy/shield/hardware.json"
  install -Dm644 hardware-darcy.json "$pkgdir/usr/lib/omarchy/shield/hardware-darcy.json"
  for operation in provision-prepare provision-commit provision-verify \
    reset-prepare reset-verify reset-commit reset-rollback update-verify \
    update-takeover luks-slots setup-boot setup-system setup-user post-install pre-remove; do
    printf '#!/bin/bash -p\nexec /usr/lib/omarchy/shield/lifecycle %s "$@"\n' "$operation" \
      > "$pkgdir/usr/lib/omarchy/shield/$operation"
    chmod 0755 "$pkgdir/usr/lib/omarchy/shield/$operation"
  done
}
