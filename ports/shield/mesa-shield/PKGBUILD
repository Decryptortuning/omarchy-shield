# Package only the coherent output of ../tools/build-mesa.py --with-x11 --with-va.
# This replaces Mesa in the separately prepared Shield ARM filesystem only.
pkgname=mesa
epoch=1
pkgver=26.2.4
pkgrel=99.1
pkgdesc='Mesa with current Tegra Gallium forwarding for the experimental Shield desktop'
arch=('aarch64')
url='https://www.mesa3d.org/'
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
depends=('expat' 'glibc' 'libdrm' 'libelf' 'libgcc' 'libglvnd' 'libstdc++'
         'libva' 'libx11' 'libxcb' 'libxext' 'libxshmfence' 'libxxf86vm'
         'lm_sensors' 'spirv-tools' 'wayland' 'zlib' 'zstd')
makedepends=('python')
provides=("libva-mesa-driver=$epoch:$pkgver-$pkgrel"
          "mesa-libgl=$epoch:$pkgver-$pkgrel" 'libva-driver' 'opengl-driver')
conflicts=('libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
replaces=('libva-mesa-driver<1:24.2.7-1' 'mesa-libgl<17.0.1-2')
options=('!strip' '!debug')
source=()
sha256sums=()

prepare() {
  [[ -n ${SHIELD_MESA_DIR:-} && -d $SHIELD_MESA_DIR ]] || {
    echo 'Set SHIELD_MESA_DIR to the complete Mesa desktop build output' >&2
    return 1
  }
  python - "$SHIELD_MESA_DIR" "$srcdir/payload" <<'PY'
import hashlib, json, os, pathlib, shutil, stat, sys
def require(condition, message):
    if not condition:
        raise SystemExit(message)
build, destination = map(pathlib.Path, sys.argv[1:])
manifest = json.loads((build / 'manifest.json').read_text())
require(manifest['format_version'] == 1, 'Unknown Mesa build manifest')
require(manifest['mesa_commit'] == '96cb43121031992b85767f9c1be8f3f48e22b1d2', 'Wrong Mesa source')
require(manifest['patch_sha256'] == '1d6219c6f80179227e57ab27d6fcbac7978dbad1d58e06601901411758dbed38', 'Wrong Tegra patch')
require(manifest['cpu'] == 'cortex-a57', 'Wrong target CPU')
require(manifest['with_x11_glx'] is True and manifest['with_va_api'] is True, 'Build X11/GLX and VA together')
root = (build / 'install').resolve(strict=True)
actual = {str(p.relative_to(root)) for p in root.rglob('*') if p.is_symlink() or not p.is_dir()}
require(actual == set(manifest['files']), 'Installed tree differs from its manifest')
for name, item in manifest['files'].items():
    relative = pathlib.PurePosixPath(name)
    require(not relative.is_absolute() and relative.parts[0] == 'usr' and '..' not in relative.parts, 'Unsafe installed path')
    source = root / name
    mode = source.lstat().st_mode
    if item['type'] == 'symlink':
        require(stat.S_ISLNK(mode) and os.readlink(source) == item['target'], 'Changed installed symlink')
        require(source.resolve(strict=True).is_relative_to(root), 'Installed symlink escapes build')
    else:
        require(item['type'] == 'file' and stat.S_ISREG(mode), 'Unexpected installed file type')
        require(stat.S_IMODE(mode) == item['mode'] and mode & 0o7000 == 0, 'Changed or special installed mode')
        require(hashlib.sha256(source.read_bytes()).hexdigest() == item['sha256'], 'Changed installed file')
for name in ['libEGL_mesa.so.0.0.0', 'libGLX_mesa.so.0.0.0', 'libgbm.so.1.0.0',
             'gbm/dri_gbm.so', 'dri/libdril_dri.so', 'dri/nouveau_drv_video.so']:
    library = root / 'usr/lib' / name
    require(library.is_file(), 'Missing ' + name)
    header = library.read_bytes()[:20]
    require(header[:4] == b'\x7fELF' and int.from_bytes(header[18:20], 'little') == 183, 'Not AArch64: ' + name)
shutil.copytree(root, destination, symlinks=True)
(destination / 'usr/share/licenses/mesa/shield-build.json').write_text(json.dumps(manifest, indent=2) + '\n')
PY
}

package() {
  # Staging-tree owners must not override fakeroot's installed root ownership.
  cp -a --no-preserve=ownership "$srcdir/payload/." "$pkgdir/"
}
